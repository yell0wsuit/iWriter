                    [
                        {
                            "id": "21",
                            "text": " Important advances in cod aquaculture have been made "
                        },
                        {
                            "id": "70",
                            "text": " in recent years "
                        },
                        {
                            "id": "22",
                            "text": " (Rosenlund and Halldorsson, 2007) "
                        },
                        {
                            "id": "21",
                            "text": " . For example, heritability estimates of production-related traits "
                        },
                        {
                            "id": "23",
                            "text": " have been published "
                        },
                        {
                            "id": "24",
                            "text": " (Gjerde et al., 2004; Kolstad et al., 2006; Odegard et al., 2009) "
                        },
                        {
                            "id": "21",
