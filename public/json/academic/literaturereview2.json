        {
            "structure": {
                "para": [
                    {
                        "id": "5",
                        "text": "Paragraph 1"
                    },
                    {
                        "id": "6",
                        "text": "Begins with a broad idea and relates earlier works to each other.\n</br>Older views are contrasted with the findings of more recent researchers."
                    }
                ]
            },
            "notes": {
                "para": []
            },
            "content": {
                "para": [
                    [
                        {
                            "id": "8",
                            "text": " While "
                        },
                        {
                            "id": "9",
                            "text": " it was initially found "
                        },
                        {
                            "id": "7",
                            "text": " that the relationship between income and happiness only holds within and not across countries—the so-called ‘Easterlin effect’— "
                        },
                        {
                            "id": "10",
                            "text": " more recent econometric studies "
                        },
                        {
                            "id": "7",
                            "text": " by "
                        },
                        {
                            "id": "11",
                            "text": " Deaton (2008) "
                        },
                        {
                            "id": "7",
                            "text": " and "
                        },
                        {
                            "id": "12",
                            "text": " Stevenson and Wolfers (2008) "
                        },
                        {
                            "id": "7",
                            "text": " based on new data collected worldwide by the Gallup Organization "
                        },
                        {
                            "id": "60",
                            "text": " have challenged this view, finding that income exerts strong effects on happiness across the board "
                        },
                        {
                            "id": "7",
                            "text": "."
                        },
                        {
                            "id": "15",
                            "text": " Sacks et al. (2010) "
                        },
                        {
                            "id": "61",
                            "text": " suggest that there is a close relationship between material living standards and life satisfaction and that countries that experience a rapid economic growth also get an equivalent increase in life satisfaction levels "
                        },
                        {
                            "id": "7",
                            "text": "."
                        }
                    ]
                ],
                "placeHolder": "Type Paragraph 1 here.",
                "id": "7"
            }
