                    {
                        "id": "70",
                        "text": "Paragraph 7: Conclusion"
                    },
                    {
                        "id": "71",
                        "text": "Summarize the information in the essay.\nEvaluate the theories, arguments or ideas by highlighting their value and mentioning their limitations."
                    },
                    {
                        "id": "",
                        "text": "Address the outcome of the comparison or contrast.",
                        "tip": true
                    }
